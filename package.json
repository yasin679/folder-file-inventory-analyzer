{
  "name": "folder-file-inventory-analyzer",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/escape-fffd.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "samples": "vitest run tests/samples.test.ts",
    "test:unit": "vitest run tests/*.test.ts",
    "test:ui": "vitest run tests/ui",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run --coverage && playwright test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
